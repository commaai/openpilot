def get_endpoint_name(name: str, stream: int) -> str: ...

class VisionBuf:
    @property
    def data(self) -> memoryview: ...

    @property
    def width(self) -> int: ...

    @property
    def height(self) -> int: ...

    @property
    def stride(self) -> int: ...

    @property
    def uv_offset(self) -> int: ...

    @property
    def idx(self) -> int: ...

    @property
    def fd(self) -> int: ...

    @property
    def frame_id(self) -> int: ...

class VisionIpcServer:
    def __init__(self, name: str) -> None: ...

    def create_buffers(self, tp: int, num_buffers: int, width: int, height: int) -> None: ...

    def create_buffers_with_sizes(self, tp: int, num_buffers: int, width: int, height: int, size: int, stride: int, uv_offset: int) -> None: ...

    def send(self, tp: int, data: bytes | bytearray | memoryview, frame_id: int = 0, timestamp_sof: int = 0, timestamp_eof: int = 0) -> None: ...

    def start_listener(self) -> None: ...

class VisionIpcClient:
    def __init__(self, name: str, stream: int, conflate: bool) -> None: ...

    @property
    def width(self) -> int | None: ...

    @property
    def height(self) -> int | None: ...

    @property
    def stride(self) -> int | None: ...

    @property
    def uv_offset(self) -> int | None: ...

    @property
    def buffer_len(self) -> int | None: ...

    @property
    def num_buffers(self) -> int: ...

    @property
    def frame_id(self) -> int: ...

    @property
    def timestamp_sof(self) -> int: ...

    @property
    def timestamp_eof(self) -> int: ...

    @property
    def valid(self) -> bool: ...

    def recv(self, timeout_ms: int = 100) -> VisionBuf | None: ...

    def connect(self, blocking: bool) -> bool: ...

    def is_connected(self) -> bool: ...

    @staticmethod
    def available_streams(name: str, block: bool) -> set[int]: ...
