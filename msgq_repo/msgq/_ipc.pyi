from collections.abc import Sequence


class IpcError(Exception):
    pass

class MultiplePublishersError(IpcError):
    pass

def toggle_fake_events(enabled: bool) -> None: ...

def set_fake_prefix(prefix: str) -> None: ...

def get_fake_prefix() -> str: ...

def delete_fake_prefix() -> None: ...

def wait_for_one_event(events: Sequence[Event], timeout: int = -1) -> int: ...

class Event:
    def __init__(self) -> None: ...

    def set(self) -> None: ...

    def clear(self) -> int: ...

    def wait(self, timeout: int = -1) -> None: ...

    def peek(self) -> bool: ...

    @property
    def fd(self) -> int: ...

    @property
    def ptr(self) -> int: ...

class SocketEventHandle:
    def __init__(self, endpoint: str, identifier: str, override: bool) -> None: ...

    @property
    def enabled(self) -> bool: ...

    @enabled.setter
    def enabled(self, arg: bool, /) -> None: ...

    @property
    def recv_called_event(self) -> Event: ...

    @property
    def recv_ready_event(self) -> Event: ...

class SubSocket:
    def __init__(self) -> None: ...

    def connect(self, endpoint: str, conflate: bool = False, segment_size: int = 0) -> None: ...

    def setTimeout(self, timeout: int) -> None: ...

    def receive(self, non_blocking: bool = False) -> bytes | None: ...

class Poller:
    def __init__(self) -> None: ...

    def registerSocket(self, socket: SubSocket) -> None: ...

    def poll(self, timeout: int) -> list[SubSocket]: ...

class PubSocket:
    def __init__(self) -> None: ...

    def connect(self, endpoint: str, segment_size: int = 0) -> None: ...

    def send(self, data: bytes) -> None: ...

    def all_readers_updated(self) -> bool: ...

    def wait_for_readers(self, timeout: float = 1.0, interval: float = 0.001) -> None: ...
