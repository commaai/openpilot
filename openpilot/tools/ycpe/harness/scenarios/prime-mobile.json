 "steps": [
  {"waitFor": ".login-card"},
  {"eval": "localStorage.setItem('comma_jwt', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZGVudGl0eSI6IjAxMjM0NTY3ODlhYmNkZWYiLCJleHAiOjE5MjQ5OTIwMDAsImlhdCI6MTc2MDAwMDAwMH0.ZmFrZS1zaWduYXR1cmU'); localStorage.setItem('billing_host', 'https://billing.comma.ai')"},
  {"goto": "/6666666666666666/prime"},
  {"waitFor": ".prime-items"},
  {"assert": "[...document.querySelectorAll('.prime-buttons button')].map((b) => b.textContent).join() === 'Update payment method,Switch to Standard plan,Cancel subscription' || 'buttons'"},
  {"shot": "manage-phone"},
  {"click": ".prime-buttons button:nth-child(2)"},
  {"waitFor": "dialog.ask"},
  {"assert": "document.querySelector('dialog.ask p').textContent === 'Switch to Standard planThe Standard plan costs $24/month, includes a data plan, and is only available in the U.S.' || document.querySelector('dialog.ask p').textContent"},
  {"shot": "switch-ask-phone"},
  {"click": "dialog.ask button[value=ok]"},
  {"waitFor": ".prime-note.prime-error"},
  {"assert": "document.querySelector('.prime-note.prime-error').textContent === 'Standard could not be activated. Make sure this device is eligible and has a usable, supported comma SIM, then try again.' || document.querySelector('.prime-note.prime-error').textContent"},
  {"assert": "(() => { const r = __sent.filter((r) => r.url.startsWith('https://billing.comma.ai/')); return JSON.stringify(r) === JSON.stringify([{method: 'POST', url: 'https://billing.comma.ai/v1/prime/switch_plan', body: JSON.stringify({dongle_id: '6666666666666666', plan: 'data', sim_id: '8901170327810000006'})}]) || JSON.stringify(r); })()"},
  {"assert": "(() => { const b = document.querySelector('.prime-buttons button:nth-child(2)'); return !b.disabled && b.textContent === 'Switch to Standard plan' || 'the switch can be tried again'; })()"},
  {"shot": "switch-error-phone"},
  {"click": ".prime-cancel"},
  {"waitFor": "dialog.ask"},
  {"assert": "!document.querySelector('dialog.ask .warn') || 'no commacare, no warranty warning'"},
  {"click": "dialog.ask button[value=ok]"},
  {"waitFor": {"fn": "document.querySelector('.prime-note.prime-error')?.textContent === 'No subscription to cancel.'"}},
  {"assert": "__sent.filter((r) => r.url.endsWith('/v1/prime/cancel')).map((r) => r.body).join() === JSON.stringify({dongle_id: '6666666666666666'}) || 'cancel body'"},
  {"assert": "!document.querySelector('.prime-cancel').disabled || 'a failed cancel can be tried again'"},
  {"key": "t"},
  {"shot": "cancel-error-phone-other-theme"},

  {"goto": "/7777777777777777/prime"},
  {"waitFor": ".prime-plan[aria-pressed=true]"},
  {"assert": "(() => { const t = document.querySelector('.prime-page').textContent; return t.includes('commacare extended warranty') && t.includes('INCLUDES COMMACARE') && document.querySelector('.prime-plan[aria-pressed=true]').dataset.plan === 'data' || t; })()"},
  {"shot": "commacare-checkout-phone-other-theme"},
  {"goto": "/7777777777777777/prime?stripe_success=cs_test_pending"},
  {"waitFor": ".prime-note.prime-loading"},
  {"assert": "document.querySelector('.prime-note.prime-loading').textContent === 'Waiting for confirmed payment' || document.querySelector('.prime-note.prime-loading').textContent"},
  {"shot": "waiting-payment-phone-other-theme"},

  {"goto": "/8888888888888888/prime"},
  {"waitFor": ".prime-page"},
  {"assert": "document.querySelector('.prime-page > p').textContent === 'No access' && !__sent.length || 'only owners'"},
  {"goto": "/8888888888888888"},
  {"waitFor": ".device-page"},
  {"assert": "!document.querySelector('.prime-promo') || 'only owners see the prime card'"}
 ]}
