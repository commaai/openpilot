{"name": "device", "url": "/", "auth": true,
 "routes": [{"url": "(/local/athena/|athena\\.comma\\.ai/)", "rpc": "setRouteViewed", "json": {"id": 0, "jsonrpc": "2.0", "result": {"success": 1}}}],
 "steps": [
  {"waitFor": ".device-name"},
  {"shot": "devices"},
  {"goto": "/5beb9b58bd12b691"},
  {"waitFor": ".device-page"},
  {"waitFor": "a.drive-row"},
  {"shot": "loaded"},
  {"click": ".list-foot .more"},
  {"waitFor": {"fn": "document.querySelectorAll('.drives a.drive-row').length > 16 && !document.querySelector('.list-foot .more').disabled"}},
  {"wheel": {"dy": 1200}},
  {"wait": 300},
  {"shot": "scrolled"},
  {"assert": "document.getElementById('main').scrollTop > 0 || 'the drive list should scroll'"},
  {"eval": "window.__left = [document.getElementById('main').scrollTop, document.querySelectorAll('.drives a.drive-row').length]"},
  {"click": [600, 450]},
  {"waitFor": ".ws", "timeout": 20000},
  {"eval": "history.back()"},
  {"waitFor": ".device-page"},
  {"assert": "new Promise((r) => requestAnimationFrame(() => { const now = [document.getElementById('main').scrollTop, document.querySelectorAll('.drives a.drive-row').length]; r(now + '' === __left + '' || `back gave scroll, drives ${now}, left at ${__left}`); }))"},
  {"shot": "back"},
  {"click": "button[data-tab=uploads]"},
  {"waitFor": {"fn": "!document.querySelector('.tab-body').textContent.includes('Loading')"}},
  {"shot": "uploads"},
  {"click": "button[data-tab=settings]"},
  {"waitFor": ".list.settings"},
  {"shot": "settings"},
  {"eval": "document.querySelector('.device-page').dataset.seen = 1; history.pushState(null, '', '/'); dispatchEvent(new PopStateEvent('popstate'))"},
  {"waitFor": {"fn": "!document.querySelector('.device-page')"}},
  {"eval": "history.pushState(null, '', '/5beb9b58bd12b691'); dispatchEvent(new PopStateEvent('popstate'))"},
  {"waitFor": "a.drive-row"},
  {"assert": "!document.querySelector('.device-page').dataset.seen || 'opening the device page again should build it afresh'"}
 ]}
