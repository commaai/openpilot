{"name": "live-stream", "url": "/live/local/drive?fake-webrtcd", "timeout": 60000,
 "steps": [
  {"waitFor": {"fn": "document.querySelector('.camera-pane video')?.videoWidth > 0"}, "timeout": 20000},
  {"waitFor": {"fn": "/^\\d+ ms$/.test(document.querySelector('.live-status span')?.textContent)"}, "timeout": 5000},
  {"assert": "!document.querySelector('.live-status i').classList.contains('poor') || 'a loopback connection shows as poor'"},
  {"shot": "stream"},
  {"click": ".live-status"},
  {"wait": 2200},
  {"assert": "(() => { const [fps, bitrate, rtt, loss] = [...document.querySelectorAll('.live-stats dd')].map((d) => d.textContent); return !document.querySelector('.live-stats').hidden && +fps > 5 && /bps$/.test(bitrate) && /ms$/.test(rtt) && /%$/.test(loss) || `stats ${fps} ${bitrate} ${rtt} ${loss}`; })()"},
  {"shot": "stats"},
  {"click": ".camera-pane video"},
  {"key": "2"},
  {"waitFor": {"fn": "__webrtcd.camera === 'driver' && document.querySelector('.camera-picker').value === 'dcamera'"}, "timeout": 3000},
  {"assert": "JSON.stringify(__webrtcd.received) === '[{\"type\":\"livestreamCameraSwitch\",\"data\":{\"camera\":\"driver\"}}]' || JSON.stringify(__webrtcd.received)"},
  {"assert": "__live.view === 'drive' || `2 in the camera pane switched the view to ${__live.view}`"},
  {"wait": 500},
  {"shot": "cabin"},
  {"select": [".live-quality", "low"]},
  {"wait": 200},
  {"assert": "JSON.stringify(__webrtcd.received.at(-1)) === '{\"type\":\"livestreamSettings\",\"data\":{\"quality\":\"low\"}}' || JSON.stringify(__webrtcd.received)"},
  {"eval": "(() => { window.__dl = []; const click = HTMLAnchorElement.prototype.click; HTMLAnchorElement.prototype.click = function () { if (!this.download) return click.call(this); fetch(this.href).then((r) => r.blob()).then((b) => __dl.push([this.download, b.type, b.size])); }; })()"},
  {"click": ".live-shot"},
  {"waitFor": {"fn": "__dl.length === 1"}, "timeout": 3000},
  {"assert": "(([name, type, size]) => /^screenshot_driver_\\d+\\.png$/.test(name) && type === 'image/png' && size > 2000 || `${name} ${type} ${size}`)(__dl[0])"},
  {"key": "1"},
  {"waitFor": {"fn": "__webrtcd.camera === 'road' && document.querySelector('.camera-picker').value === 'fcamera'"}, "timeout": 3000},
  {"assert": "JSON.stringify(__webrtcd.received.at(-1)) === '{\"type\":\"livestreamCameraSwitch\",\"data\":{\"camera\":\"road\"}}' || JSON.stringify(__webrtcd.received)"},
  {"eval": "__live.session.source.stats = async () => new Map([['t', {type: 'transport', selectedCandidatePairId: 'p'}], ['p', {type: 'candidate-pair', currentRoundTripTime: 0.4}]])"},
  {"waitFor": {"fn": "document.querySelector('.live-status i').classList.contains('poor')"}, "timeout": 3000},
  {"assert": "document.querySelector('.live-status span').textContent === '400 ms' || document.querySelector('.live-status span').textContent"},
  {"shot": "poor"},
  {"click": ".pb-live"},
  {"key": "2"},
  {"assert": "__live.view === 'plot' || '2 outside the camera pane should switch views'"}
 ]}
