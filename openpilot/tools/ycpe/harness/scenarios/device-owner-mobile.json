{"name": "device-owner-mobile", "url": "/", "auth": true, "timeout": 15000, "viewport": {"width": 390, "height": 844, "mobile": true},
 "routes": [
  {"preset": "device"},
  {"url": "/local/athena/0123456789abcdef$", "file": "fixtures/fake-athena.json"}
 ],
 "steps": [
  {"waitFor": ".device-name"},
  {"eval": "history.pushState(null, '', '/0123456789abcdef'); dispatchEvent(new PopStateEvent('popstate'))"},
  {"waitFor": "a.drive-row"},
  {"waitFor": ".device-info .battery:not([hidden])"},
  {"wait": 800},
  {"shot": "loaded"},
  {"click": ".list-foot .filter"},
  {"assert": "document.querySelector('.drive-opts').checkVisibility() || 'Filter shows the dates'"},
  {"shot": "filter-details"},
  {"eval": "document.getElementById('main').scrollTop = 0"},
  {"click": [195, 104]},
  {"waitFor": ".map-card:not([hidden])"},
  {"wait": 800},
  {"shot": "map-card"},
  {"click": ".device-actions button[aria-label='Take snapshot']"},
  {"waitFor": ".snapshot img"},
  {"shot": "snapshot"},
  {"eval": "import('/theme.js').then(({theme}) => theme.set(theme.name === 'dark' ? 'light' : 'dark'))"},
  {"shot": "snapshot-other-theme"},
  {"click": "button[data-tab=settings]"},
  {"waitFor": ".list.settings"},
  {"eval": "document.getElementById('main').scrollTop = 1e6"},
  {"shot": "settings-unpair"}
 ]}
