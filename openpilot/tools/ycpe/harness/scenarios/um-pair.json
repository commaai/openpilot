{"name": "um-pair", "url": "/connect", "mode": "user", "timeout": 15000,
 "routes": [
  {"url": "^https://api\\.commadotai\\.com/", "json": []},
  {"url": "^https://api\\.commadotai\\.com/v1/me/$", "json": {"id": "fffffffffffffff0", "user_id": "github_1234567", "email": "dev@example.com", "username": "devuser", "superuser": false}},
  {"url": "^https://api\\.commadotai\\.com/v1/me/devices/$", "json": []},
  {"url": "/v1\\.1/devices/0123456789abcdef/$", "file": "fixtures/fake-device.json"},
  {"url": "/v1\\.1/devices/0123456789abcdef/stats$", "json": {"all": {"routes": 3, "distance": 30.6, "minutes": 46}, "week": {"routes": 2, "distance": 20.4, "minutes": 31}}},
  {"url": "/v1/devices/0123456789abcdef/routes_segments", "file": "fixtures/fake-routes.json"},
  {"url": "/v1/prime/subscription", "status": 404, "body": ""},
  {"url": "^https://billing\\.comma\\.ai/", "json": {"code": "ABC123", "limit_reached": false, "cash": {"claimed": 0, "pending": 0, "available": 0}, "referrals": []}},
  {"url": "(/local/athena/|athena\\.comma\\.ai/)", "file": "fixtures/fake-athena.json"},
  {"url": "^https://api\\.commadotai\\.com/v2/pilotpair/$", "method": "POST", "json": {"first_pair": true, "dongle_id": "0123456789abcdef"}}
 ],
 "allow": ["404 GET .*/v1/prime/subscription"],
 "steps": [
  {"eval": "localStorage.setItem('comma_jwt', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZGVudGl0eSI6IjAxMjM0NTY3ODlhYmNkZWYiLCJleHAiOjE5MjQ5OTIwMDAsImlhdCI6MTc2MDAwMDAwMH0.ZmFrZS1zaWduYXR1cmU')"},
  {"goto": "/connect"},
  {"waitFor": ".pair-empty.um .pair-picture img"},
  {"assert": "(() => { const t = document.querySelector('.pair-empty.um').textContent; return ['Pair your device', 'Your device is connected to the internet', 'may already be paired to another account'].every((s) => t.includes(s)) && document.querySelector('.pair-empty.um .pair-cn').textContent === 'add new device' || t; })()"},
  {"assert": "(() => { const s = getComputedStyle(document.querySelector('.pair-empty.um .pair-copy p')); return s.fontSize === '16px' && s.lineHeight === '28px' || `connect's prose: ${s.fontSize}/${s.lineHeight}`; })()"},
  {"wait": 300},
  {"shot": "no-devices"},
  {"eval": "import('/theme.js').then(({theme}) => theme.set(theme.name === 'dark' ? 'light' : 'dark'))"},
  {"wait": 300},
  {"shot": "no-devices-other-theme"},

  {"eval": "delete window.BarcodeDetector; navigator.mediaDevices.enumerateDevices = async () => []; true"},
  {"click": ".pair-empty.um .pair-cn"},
  {"waitFor": ".cnui-modal .pair-paper .pair-paste"},
  {"assert": "!document.querySelector('.cnui-modal .icon-btn') && document.querySelector('.pair-paper .pair-title h2').textContent === 'Pair device' || 'connect\\'s title and rule, no x'"},
  {"fill": [".pair-paste input", "not a pair link"]},
  {"click": ".pair-paste .cnui-btn"},
  {"waitFor": {"fn": "document.querySelector('.pair-status:not([hidden])')?.textContent.includes('Error: invalid QR code detected')"}, "timeout": 5000},
  {"shot": "no-reader"},
  {"eval": "import('/theme.js').then(({theme}) => theme.set(theme.name === 'dark' ? 'light' : 'dark'))"},
  {"wait": 300},
  {"shot": "no-reader-other-theme"},
  {"key": "Escape"},
  {"waitFor": {"fn": "!document.querySelector('.cnui-modal')"}},

  {"eval": "window.BarcodeDetector = class { static async getSupportedFormats() { return ['qr_code']; } async detect() { return []; } }; true"},
  {"click": ".pair-empty.um .pair-cn"},
  {"waitFor": ".cnui-modal .pair-paper p"},
  {"assert": "(() => { const t = document.querySelector('.pair-paper .pair-body').textContent; return t.startsWith('Camera not found, please enable camera access.') && !document.querySelector('.pair-paper .pair-paste') || t; })()"},
  {"shot": "no-camera"},
  {"click": [12, 12]},
  {"waitFor": {"fn": "!document.querySelector('.cnui-modal')"}},

  {"eval": "window.__qr = null; window.BarcodeDetector = class { static async getSupportedFormats() { return ['qr_code']; } async detect() { return __qr ? [{rawValue: __qr}] : []; } }; navigator.mediaDevices.enumerateDevices = async () => [{kind: 'videoinput', deviceId: 'fake', label: 'fake camera'}]; navigator.mediaDevices.getUserMedia = async () => { const cv = Object.assign(document.createElement('canvas'), {width: 640, height: 480}), g = cv.getContext('2d'); g.fillStyle = '#3a4650'; g.fillRect(0, 0, 640, 480); return window.__stream = cv.captureStream(1); }; true"},
  {"click": ".pair-empty.um .pair-cn"},
  {"waitFor": {"fn": "document.querySelector('.pair-paper .pair-video video')?.readyState >= 2"}},
  {"wait": 300},
  {"shot": "scanner"},
  {"eval": "__qr = 'https://connect.comma.ai/?pair=eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZGVudGl0eSI6IjAxMjM0NTY3ODlhYmNkZWYiLCJwYWlyIjp0cnVlLCJpYXQiOjE3OTI0MDAwMDAsImV4cCI6MTc5MjQwMzYwMH0.ZmFrZS1wYWly'"},
  {"waitFor": {"fn": "document.querySelector('.pair-status:not([hidden])')?.textContent.includes('Successfully paired device 0123456789abcdef')"}, "timeout": 5000},
  {"assert": "(() => { const r = __sent.filter((r) => r.url.includes('/v2/pilotpair/')); return r.length === 1 && r[0].method === 'POST' || JSON.stringify(r); })()"},
  {"shot": "paired"},
  {"click": ".pair-status .cnui-btn"},
  {"waitFor": {"fn": "location.pathname === '/connect/0123456789abcdef'"}},
  {"assert": "__stream.getTracks().every((t) => t.readyState === 'ended') || 'closing should stop the camera'"},

  {"goto": "/connect?pair=eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZGVudGl0eSI6IjAxMjM0NTY3ODlhYmNkZWYiLCJwYWlyIjp0cnVlLCJpYXQiOjE3OTI0MDAwMDAsImV4cCI6MTc5MjQwMzYwMH0.ZmFrZS1wYWly"},
  {"waitFor": {"fn": "document.querySelector('.pair-paper.link .pair-status')?.textContent.includes('Successfully paired device 0123456789abcdef')"}, "timeout": 5000},
  {"assert": "document.querySelector('.pair-paper.link .pair-title h2').textContent === 'Pairing device' && document.querySelector('.pair-paper.link .cnui-btn.grey').textContent === 'Close' || document.querySelector('.pair-paper.link').textContent"},
  {"assert": "!location.search.includes('pair=') || 'the token leaves the URL'"},
  {"assert": "__sent.filter((r) => r.url.includes('/v2/pilotpair/') && r.method === 'POST').length === 1 || JSON.stringify(__sent)"},
  {"shot": "pair-link"},
  {"click": ".pair-paper.link .cnui-btn.grey"},
  {"waitFor": {"fn": "location.pathname === '/connect/0123456789abcdef' && !document.querySelector('.cnui-modal')"}},
  {"viewport": [390, 844]},
  {"goto": "/connect"},
  {"waitFor": ".pair-empty.um .pair-picture img"},
  {"wait": 300},
  {"shot": "no-devices-phone"}
 ]}
