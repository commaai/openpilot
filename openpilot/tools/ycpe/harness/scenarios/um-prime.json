{"name": "um-prime", "url": "/connect", "mode": "user", "viewport": {"width": 1440, "height": 900}, "timeout": 15000,
 "routes": [
  {"url": "^https://api\\.commadotai\\.com/", "json": []},
  {"url": "^https://billing\\.comma\\.ai/", "status": 404, "json": {"error": "not faked"}},
  {"url": "^https://api\\.commadotai\\.com/v1/me/$", "json": {"id": "0123456789abcdef", "user_id": "github_1234567", "email": "dev@example.com", "username": "devuser", "regdate": 1600000000, "superuser": false, "prime": true}},
  {"url": "^https://api\\.commadotai\\.com/v1/me/devices/$", "json": [
    {"dongle_id": "1111111111111111", "alias": "tici", "is_owner": true, "prime": false, "device_type": "threex", "openpilot_version": "0.10.1", "last_athena_ping": 0, "eligible_features": {"prime_data": true, "commacare": false}},
    {"dongle_id": "3333333333333333", "alias": "bronco", "is_owner": true, "prime": true, "commacare": true, "device_type": "four", "openpilot_version": "0.11.2", "last_athena_ping": 0, "eligible_features": {"prime_data": true, "commacare": true}}]},
  {"url": "/v1\\.1/devices/(1111111111111111|3333333333333333)/stats$", "json": {"all": {"routes": 0, "distance": 0, "minutes": 0}, "week": {"routes": 0, "distance": 0, "minutes": 0}}},
  {"url": "^https://billing\\.comma\\.ai/v1/prime/subscribe_info\\?dongle_id=1111111111111111$", "json": {"has_prime": false, "trial_end_data": 1793000000, "trial_end_nodata": 1792000000,
    "sim_id": "8901170327810000001", "sim_type": "blue", "sim_usable": true, "is_prime_sim": true, "device_online": true, "data_connected": true}},
  {"url": "^https://billing\\.comma\\.ai/v1/prime/subscription\\?dongle_id=3333333333333333$", "json": {"sim_id": "8901170327810000003", "user_id": "github_1234567", "plan": "data", "is_prime_sim": true,
    "trial_end": null, "next_charge_at": 1795000000, "subscribed_at": 1760000000, "cancel_at": null, "amount": 2400, "requires_migration": false}},
  {"url": "^https://billing\\.comma\\.ai/v1/prime/switch_plan$", "method": "POST", "json": {"success": 1}},
  {"url": "^https://billing\\.comma\\.ai/v1/prime/cancel$", "method": "POST", "json": {"success": 1}}
 ],
 "allow": ["404 GET https://billing\\.comma\\.ai/", "404 GET .*/v1/prime/subscription"],
 "steps": [
  {"eval": "localStorage.setItem('comma_jwt', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZGVudGl0eSI6IjAxMjM0NTY3ODlhYmNkZWYiLCJleHAiOjE5MjQ5OTIwMDAsImlhdCI6MTc2MDAwMDAwMH0.ZmFrZS1zaWduYXR1cmU'); localStorage.setItem('billing_host', 'https://billing.comma.ai'); localStorage.setItem('ycpe_referrals_promo_2026-09-02', '1')"},
  {"goto": "/connect/1111111111111111"},
  {"waitFor": ".cnui-promo a"},
  {"assert": "document.querySelector('.cnui-promo a').getAttribute('href') === '/connect/1111111111111111/prime' || document.querySelector('.cnui-promo a').getAttribute('href')"},
  {"assert": "(() => { const r = document.querySelector('.cnui-promo').getBoundingClientRect(); const c = document.querySelector('.cn-content'); return c.getBoundingClientRect().left + c.clientWidth - r.right === 10 || `connect's corner: ${JSON.stringify(r)}`; })()"},
  {"shot": "promo"},
  {"click": ".cnui-promo a"},
  {"waitFor": ".prime-page.um .prime-plan[aria-pressed=true]"},
  {"assert": "location.pathname === '/connect/1111111111111111/prime' || location.pathname"},
  {"assert": "[...document.querySelectorAll('.prime-page.um .prime-checks p')].map((p) => p.textContent).join() === '24/7 connectivity,Take pictures remotely,1 year storage of drive videos,Simple SSH for developers' || 'checklist'"},
  {"assert": "document.querySelector('.prime-page.um .prime-plan[aria-pressed=true]').dataset.plan === 'data' && document.querySelector('.prime-page.um .prime-go').textContent === 'Claim trial' || document.querySelector('.prime-page.um').textContent"},
  {"assert": "(() => { const s = getComputedStyle(document.querySelector('.prime-page.um .prime-title')); return s.fontSize === '16px' && s.fontWeight === '400' || s.fontSize; })()"},
  {"shot": "checkout"},
  {"eval": "import('/theme.js').then(({theme}) => theme.set(theme.name === 'dark' ? 'light' : 'dark'))"},
  {"shot": "checkout-other-theme"},
  {"eval": "import('/theme.js').then(({theme}) => theme.set(theme.name === 'dark' ? 'light' : 'dark'))"},
  {"assert": "!__sent.length || 'looking sends nothing: ' + JSON.stringify(__sent)"},

  {"goto": "/connect/3333333333333333/prime"},
  {"waitFor": ".prime-manage:not([hidden]) .prime-buttons"},
  {"eval": "window.__buttons = () => [...document.querySelectorAll('.prime-manage .prime-buttons button')].map((b) => b.textContent).join(); true"},
  {"assert": "__buttons() === 'Update payment method,Switch to Lite plan,Cancel subscription' || __buttons()"},
  {"assert": "[...document.querySelectorAll('.prime-manage .prime-item h3')].map((h) => h.textContent).join() === 'Device,Plan,Joined,Next payment,Amount' || 'items'"},
  {"assert": "!!document.querySelector('.prime-manage .prime-pill img') || 'the commacare pill'"},
  {"shot": "manage"},

  {"click": ".prime-manage .prime-buttons button:nth-child(2)"},
  {"waitFor": ".cnui-modal .prime-paper .prime-modal-confirm"},
  {"assert": "!document.querySelector('dialog.ask') && document.querySelector('.prime-paper .prime-modal-title').textContent === 'Switch to Lite plan' || 'connect\\'s dialog, not ask()'"},
  {"assert": "!document.querySelector('.prime-paper').textContent.includes('false') || document.querySelector('.prime-paper').textContent"},
  {"shot": "switch"},
  {"click": ".prime-paper .prime-modal-close"},
  {"waitFor": {"fn": "!document.querySelector('.cnui-modal')"}},
  {"assert": "!__sent.some((r) => r.url.endsWith('/switch_plan')) || 'cancelling sends nothing'"},
  {"click": ".prime-manage .prime-buttons button:nth-child(2)"},
  {"click": ".prime-paper .prime-modal-confirm"},
  {"waitFor": ".prime-paper .prime-modal-ok"},
  {"assert": "document.querySelector('.prime-paper .prime-modal-title').textContent === 'Welcome to Lite' && document.querySelector('.prime-paper .prime-modal-close').textContent === 'Done' || document.querySelector('.prime-paper').textContent"},
  {"assert": "(() => { const r = __sent.filter((r) => r.url.startsWith('https://billing.comma.ai/') && r.method !== 'GET'); return JSON.stringify(r) === JSON.stringify([{method: 'POST', url: 'https://billing.comma.ai/v1/prime/switch_plan', body: JSON.stringify({dongle_id: '3333333333333333', plan: 'nodata', sim_id: null})}]) || JSON.stringify(r); })()"},
  {"shot": "switched"},
  {"click": ".prime-paper .prime-modal-close"},
  {"waitFor": {"fn": "!document.querySelector('.cnui-modal')"}},

  {"click": ".prime-manage .prime-cancel"},
  {"waitFor": ".cnui-modal .prime-paper.cancel .prime-modal-care"},
  {"shot": "cancel"},
  {"click": ".prime-paper.cancel .prime-modal-confirm"},
  {"waitFor": ".prime-paper.cancel .prime-modal-ok"},
  {"assert": "document.querySelector('.prime-paper.cancel .prime-modal-ok').textContent === 'Cancelled subscription.' && document.querySelector('.prime-paper.cancel .prime-modal-confirm').disabled || document.querySelector('.prime-paper.cancel').textContent"},
  {"assert": "(() => { const r = __sent.filter((r) => r.url.endsWith('/v1/prime/cancel')); return JSON.stringify(r) === JSON.stringify([{method: 'POST', url: 'https://billing.comma.ai/v1/prime/cancel', body: JSON.stringify({dongle_id: '3333333333333333'})}]) || JSON.stringify(r); })()"},
  {"shot": "cancelled"},
  {"key": "Escape"},
  {"waitFor": {"fn": "!document.querySelector('.cnui-modal')"}},
  {"viewport": [390, 844]},
  {"shot": "manage-phone"}
 ]}
