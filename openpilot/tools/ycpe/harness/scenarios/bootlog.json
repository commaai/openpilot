{"name": "bootlog", "url": "/5beb9b58bd12b691?tab=bootlogs", "auth": true, "timeout": 30000,
 "lint_ignore": ["#main"],
 "steps": [
  {"waitFor": "table.list tr.clickable"},
  {"click": "table.list tr.clickable"},
  {"waitFor": ".boot-section"},
  {"assert": "document.querySelectorAll('.boot-section').length >= 3 || 'expected the launch log, a command and pstore'"},
  {"shot": "open"},
  {"key": "Control+f"},
  {"assert": "document.activeElement.classList.contains('boot-filter') || 'ctrl+f should focus the filter'"},
  {"fill": [".boot-filter", "error"]},
  {"waitFor": {"fn": "document.querySelector('.log-text mark')"}},
  {"shot": "filtered"},
  {"key": "Escape"},
  {"assert": "document.querySelector('dialog[open]') && !document.querySelector('.boot-filter').value || 'escape should clear the filter first'"},
  {"key": "Escape"},
  {"assert": "!document.querySelector('dialog[open]') || 'escape should close the viewer'"}
 ]}
