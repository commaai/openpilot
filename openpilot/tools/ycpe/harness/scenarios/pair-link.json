{"name": "pair-link", "url": "/", "timeout": 15000, "allow": ["403 POST .*/v2/pilotpair/$"],
 "routes": [
  {"url": "^https://api\\.commadotai\\.com/", "json": []},
  {"url": "^https://api\\.commadotai\\.com/v1/me/$", "json": {"id": "fffffffffffffff0", "user_id": "github_1234567", "email": "dev@example.com", "username": "devuser", "superuser": false}},
  {"url": "^https://api\\.commadotai\\.com/v1/me/devices/$", "json": [{"dongle_id": "0123456789abcdef", "alias": "tici", "is_owner": true, "device_type": "threex", "openpilot_version": "0.10.1", "last_athena_ping": 0}, {"dongle_id": "2222222222222222", "alias": "friend's car", "is_owner": false, "device_type": "mici", "openpilot_version": "0.10.1", "last_athena_ping": 0}]},
  {"preset": "device"},
  {"url": "(^https://billing\\.comma\\.ai/|/local/billing/)", "json": {"code": "ABC123", "limit_reached": false, "cash": {"claimed": 0, "pending": 0, "available": 0}, "referrals": []}},
  {"url": "(/local/athena/|athena\\.comma\\.ai/)", "file": "fixtures/fake-athena.json"},
  {"url": "^https://api\\.commadotai\\.com/v2/pilotpair/$", "method": "POST", "status": 403, "json": {"error": "Forbidden"}}
 ],
 "steps": [
  {"waitFor": ".login-card"},
  {"eval": "localStorage.setItem('comma_jwt', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZGVudGl0eSI6IjAxMjM0NTY3ODlhYmNkZWYiLCJleHAiOjE5MjQ5OTIwMDAsImlhdCI6MTc2MDAwMDAwMH0.ZmFrZS1zaWduYXR1cmU')"},
  {"goto": "/?pair=eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZGVudGl0eSI6IjAxMjM0NTY3ODlhYmNkZWYiLCJwYWlyIjp0cnVlLCJpYXQiOjE3OTI0MDAwMDAsImV4cCI6MTc5MjQwMzYwMH0.ZmFrZS1wYWly"},
  {"waitFor": {"fn": "document.querySelector('.pair-status:not([hidden])')?.textContent.includes(\"Error: device paired with different owner - make sure you logged in with the correct account, please try again\")"}, "timeout": 5000},
  {"assert": "(() => { const r = __sent.filter((r) => r.url.includes('/v2/pilotpair/')); return r.length === 1 && r.every((r) => r.method === 'POST' && r.url === 'https://api.commadotai.com/v2/pilotpair/' && r.body === 'pair_token=eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZGVudGl0eSI6IjAxMjM0NTY3ODlhYmNkZWYiLCJwYWlyIjp0cnVlLCJpYXQiOjE3OTI0MDAwMDAsImV4cCI6MTc5MjQwMzYwMH0.ZmFrZS1wYWly') || JSON.stringify(r); })()"},
  {"assert": "location.search === '' && !!localStorage.getItem('comma_jwt') || 'the token leaves the URL and a refusal keeps us signed in'"},
  {"shot": "link-refused"},
  {"click": ".pair-actions .button"},
  {"waitFor": ".list.devices"},
  {"wait": 100},
  {"assert": "location.pathname === '/' && !document.querySelector('.pair-dialog') || location.href"},
  {"eval": "delete window.BarcodeDetector; navigator.mediaDevices.enumerateDevices = async () => []; true"},
  {"click": ".add-device"},
  {"waitFor": ".pair-paste"},
  {"wait": 200},
  {"shot": "add-device"},
  {"eval": "import('/theme.js').then(({theme}) => theme.set(theme.name === 'dark' ? 'light' : 'dark'))"},
  {"wait": 200},
  {"shot": "add-device-dark"},
  {"key": "Escape"},
  {"wait": 200},
  {"shot": "home-dark"},
  {"goto": "/0123456789abcdef"},
  {"waitFor": ".device-page"},
  {"click": ".topbar .crumb[title=Devices]"},
  {"click": ".menu-list button.menu-row"},
  {"waitFor": ".pair-paste"},
  {"shot": "menu-add-device-dark"}
 ]}
