{"name": "um-phone", "url": "/", "mode": "user", "auth": true, "timeout": 15000, "viewport": {"width": 390, "height": 844, "mobile": true},
 "routes": [
  {"url": "/(pages/pair|pages/prime|panes/clips)\\.js$", "file": "fixtures/um-pair.js"},
  {"url": "/v1/me/devices/$", "json": [
    {"dongle_id": "0123456789abcdef", "alias": "Bronco", "device_type": "threex", "openpilot_version": "0.10.0", "is_owner": true, "prime": false, "last_athena_ping": 4102444800},
    {"dongle_id": "fedcba9876543210", "alias": "", "device_type": "tizi", "openpilot_version": "0.9.7", "is_owner": false, "prime": true, "last_athena_ping": 1700000000}]},
  {"url": "/v1\\.1/devices/0123456789abcdef/$", "file": "fixtures/fake-device.json"},
  {"url": "/v1\\.1/devices/0123456789abcdef/stats$", "json": {"all": {"routes": 3, "distance": 30.6, "minutes": 46}, "week": {"routes": 2, "distance": 20.4, "minutes": 31}}},
  {"url": "/v1/devices/0123456789abcdef/location$", "json": {"dongle_id": "0123456789abcdef", "lat": 32.8751, "lng": -117.21, "time": 1792430925000}},
  {"url": "/v1/devices/0123456789abcdef/routes_segments", "file": "fixtures/fake-routes.json"},
  {"url": "/v1/prime/subscription", "status": 404, "body": ""},
  {"url": "(/local/athena/|athena\\.comma\\.ai/)0123456789abcdef$", "file": "fixtures/fake-athena.json"},
  {"url": "(/local/athena/|athena\\.comma\\.ai/)5beb9b58bd12b691$", "rpc": "setRouteViewed", "json": {"id": 0, "jsonrpc": "2.0", "result": {"success": 1}}}
 ],
 "allow": ["404 GET .*/v1/prime/subscription"],
 "steps": [
  {"waitFor": ".cn-content .home-page .list.devices"},
  {"assert": "location.pathname === '/connect' || `a phone lists the devices first: ${location.pathname}`"},
  {"assert": "!document.querySelector('.cn-side').checkVisibility({visibilityProperty: true}) && document.querySelector('.cn-menu').checkVisibility() || 'the device list is a drawer behind the menu button'"},
  {"assert": "document.querySelector('.cn-header').getBoundingClientRect().right <= innerWidth && !document.querySelector('.cn-devmode > span').checkVisibility() || 'the header fits, Developer mode as its icon'"},
  {"shot": "home"},
  {"click": ".home-page .list.devices a[href='/0123456789abcdef']"},
  {"waitFor": "a.drive-row"},
  {"assert": "location.pathname === '/connect/0123456789abcdef' || `the device in user mode: ${location.pathname}`"},
  {"wait": 800},
  {"shot": "device"},
  {"click": ".cn-menu"},
  {"wait": 400},
  {"assert": "document.querySelector('.cn-side').checkVisibility({visibilityProperty: true}) && document.querySelector('.cn-menu').ariaExpanded === 'true' || 'the menu opens the device list'"},
  {"shot": "drawer"},
  {"click": [370, 400]},
  {"wait": 400},
  {"assert": "!document.querySelector('.cn-shell').classList.contains('open') || 'a tap beside the drawer closes it'"},
  {"goto": "/5beb9b58bd12b691/0000010a--a51155e496"},
  {"waitFor": ".cn-content .connect-pane .camera-pane"},
  {"assert": "location.pathname === '/connect/5beb9b58bd12b691/0000010a--a51155e496' || `the drive in user mode: ${location.pathname}`"},
  {"assert": "!document.querySelector(':is(.views, .tabs, .playbar, .omnibox)')?.checkVisibility() && document.querySelector('.cn-timeline').getBoundingClientRect().width >= innerWidth - 40 || 'connect\\'s phone drive view, no developer chrome'"},
  {"wait": 1500},
  {"shot": "drive"},
  {"eval": "import('/theme.js').then(({theme}) => theme.set(theme.name === 'dark' ? 'light' : 'dark'))"},
  {"wait": 500},
  {"shot": "drive-other-theme"},
  {"click": ".cn-devmode"},
  {"waitFor": ".topbar .views .view.on"},
  {"assert": "/^\\/5beb9b58bd12b691\\/0000010a--a51155e496\\/drive$/.test(location.pathname) || `developer mode on the same drive: ${location.pathname}`"},
  {"assert": "document.querySelector('.topbar .mode-btn').checkVisibility() && document.querySelector('.topbar').scrollWidth <= innerWidth || 'the developer bar keeps its way back, inside the window'"},
  {"wait": 500},
  {"shot": "dev-drive"},
  {"click": ".topbar .mode-btn"},
  {"waitFor": ".cn-content .connect-pane"},
  {"click": ".cn-top a.cn-icon"},
  {"waitFor": "a.drive-row, .cn-content .login-card, .cn-content .page-msg"},
  {"assert": "location.pathname === '/connect/5beb9b58bd12b691' || `closing goes to the drive's device: ${location.pathname}`"},
  {"goto": "/connect"},
  {"waitFor": ".cn-content .home-page .list.devices"},
  {"eval": "import('/theme.js').then(({theme}) => theme.set('dark'))"},
  {"wait": 300},
  {"shot": "home-dark"}
 ]}
