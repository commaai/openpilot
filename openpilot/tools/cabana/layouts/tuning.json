      "name": "engaged curvature yaw",
      "source": "/carControl/angularVelocity/2",
      "globals": "engage_delay = 5\nlast_bad_time = -engage_delay",
      "function": "global last_bad_time\nif v1 == 1 or v2 == 0:\n  last_bad_time = time\nif time > last_bad_time + engage_delay:\n  return value / v3 if v3 != 0 else math.nan\nreturn 0",
