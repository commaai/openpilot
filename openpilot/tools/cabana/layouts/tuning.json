      ],
      "code": "_last_bad_time = -5\n\ndef derive(value, v1, v2, v3, v4, time):\n    global _last_bad_time\n    engage_delay = 5\n    curvature = value / v3 if v3 != 0 else 0\n    if v1 == 1 or v2 == 0:\n        _last_bad_time = time\n    return curvature if time > _last_bad_time + engage_delay else 0\n"
