import glob
import os
import shutil
import shlex
import time
from SCons.Script import Action, Value
from openpilot.common.file_chunker import chunk_file, get_chunk_targets, get_existing_chunks, open_file_chunked
from openpilot.common.transformations.model import DM_INPUT_SIZE
from openpilot.selfdrive.modeld.constants import ModelConstants
from openpilot.selfdrive.modeld.helpers import chestnut_present, modeld_pkl_path
from openpilot.selfdrive.modeld.model_config import CAMERA_CONFIGS, driving_model_args, warp_args


Import('env', 'arch')
chunker_file = File("#openpilot/common/file_chunker.py")
lenv = env.Clone()

tinygrad_root = env.Dir("#").abspath
tinygrad_files = ["#"+x for x in glob.glob(env.Dir("#tinygrad_repo").relpath + "/**", recursive=True, root_dir=tinygrad_root)
                  if 'pycache' not in x and os.path.isfile(os.path.join(tinygrad_root, x))]

def estimate_pickle_max_size(onnx_size):
  # QCOM programs for models with spatial recurrent features can approach 2x
  # the ONNX size. Overestimating only adds an empty trailing chunk.
  return 2.0 * onnx_size + 10 * 1024 * 1024

compiler_files = [File(name) for name in ('compile_onnx.py', 'compile_warp.py', 'helpers.py', 'model_config.py')]

if arch == 'comma_arm64':
  tg_flags = 'DEV=QCOM IMAGE=1 FLOAT16=1 NOLOCALS=1 JIT_BATCH_SIZE=0 OPENPILOT_HACKS=1'
else:
  # JIT=2 disables graph batching, which produces incorrect outputs after buffers change.
  tg_flags = 'DEV=METAL JIT=2' if arch == 'Darwin' else 'DEV=CPU:LLVM'

# tinygrad calls brew which needs a $HOME in the env
mac_brew_string = f'HOME={os.path.expanduser("~")}' if arch == 'Darwin' else ''

compiler = 'python3 -m openpilot.selfdrive.modeld.compile_onnx'


def model_onnx(name):
  path = File(f"models/{name}.onnx").abspath
  sources = get_existing_chunks(path)
  if sources == [path]:
    return path
  def unchunk(target, source, env):
    with open_file_chunked(path) as src, open(str(target[0]), 'wb') as dst:
      shutil.copyfileobj(src, dst)
  return str(lenv.Command(path + '.unchunked', sources + [chunker_file], unchunk)[0])


def compile_and_chunk(path, onnx, command, size_multiplier=1, chestnut=False):
  sources = get_existing_chunks(onnx.removesuffix('.unchunked'))
  chunks = get_chunk_targets(path, estimate_pickle_max_size(sum(os.path.getsize(x) for x in sources) * size_multiplier))
  def do_compile(target, source, env):
    if chestnut:
      from openpilot.system.hardware.chestnut.flash import link_up
      # Chestnut can enumerate before its PCIe link is ready.
      for _ in range(10):
        if link_up():
          break
        time.sleep(1)
      else:
        print("Chestnut not ready, skipping big model build")
        return
    if ret := env.Execute(command):
      return ret
    chunk_file(path, chunks)
  node = lenv.Command(chunks,
                      [onnx] + tinygrad_files + compiler_files + [Value(command), Value(chunks), chunker_file],
                      Action(do_compile, "  [COMPILE] $TARGET"))
  if chestnut:
    # The USB+AMD GPU takes an exclusive flock; serialize targets that use it.
    lenv.SideEffect(File("models/.chestnut.lock"), node)
  return node


frame_skip = ModelConstants.MODEL_RUN_FREQ // ModelConstants.MODEL_CONTEXT_FREQ
# CPU 7 is isolated with isolcpus on AGNOS, so explicitly pin the compiler to it.
taskset = 'taskset -c 7 ' if arch == 'comma_arm64' else ''
for chestnut in [False, True] if chestnut_present() else [False]:
  flags = 'DEBUG=1 DEV=USB+AMD:LLVM FLOAT16=1 JIT_BATCH_SIZE=0 GMMU=0 TC_OPT=2 TC_MIN_GLOBALS=32' if chestnut else tg_flags
  onnx = model_onnx(('big_' if chestnut else '') + 'driving_supercombo')
  pkl = File(modeld_pkl_path(chestnut)).abspath
  command = f'{flags} {mac_brew_string} {taskset}{compiler} {onnx} {pkl} {shlex.join(driving_model_args(frame_skip))} --benchmark-runs 1'
  compile_and_chunk(pkl, onnx, command, size_multiplier=len(CAMERA_CONFIGS), chestnut=chestnut)

onnx = model_onnx('dmonitoring_model')
pkl = File('models/dmonitoring_model_tinygrad.pkl').abspath
command = (f'{tg_flags} OPENPILOT_HACKS=1 JIT_BATCH_SIZE=0 {mac_brew_string} {compiler} {onnx} {pkl} ' +
           '--float32 --device-input input_img --benchmark-runs 1')
compile_and_chunk(pkl, onnx, command)

for cam_w, cam_h in CAMERA_CONFIGS:
  pkl = File(f'models/dm_warp_{cam_w}x{cam_h}_tinygrad.pkl').abspath
  command = (f'{tg_flags} {mac_brew_string} python3 -m openpilot.selfdrive.modeld.compile_warp ' +
             f'{shlex.join(warp_args(cam_w, cam_h, DM_INPUT_SIZE, "luma", border_fill=16))} --output {pkl} --benchmark-runs 1')
  lenv.Command(pkl, tinygrad_files + compiler_files + [Value(command)], command)
