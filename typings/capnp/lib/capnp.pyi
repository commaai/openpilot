# pycapnp is Cython and ships no stubs. capnp schemas are loaded at runtime, so their structs are dynamic.
from collections.abc import Iterator, Sequence
from typing import Any

class KjException(Exception):
  description: str
  type: Any

class _DynamicObject:
  def __getattr__(self, name: str) -> Any: ...
  def __setattr__(self, name: str, value: Any) -> None: ...

class _DynamicStructReader(_DynamicObject): ...
class _DynamicStructBuilder(_DynamicObject): ...
class _DynamicEnum(_DynamicObject): ...
class _StructModule(_DynamicObject): ...
class _StructSchema(_DynamicObject): ...
class _StructSchemaField(_DynamicObject): ...

class _DynamicListReader(_DynamicObject):
  def __len__(self) -> int: ...
  def __getitem__(self, index: int) -> Any: ...
  def __iter__(self) -> Iterator[Any]: ...

class _DynamicListBuilder(_DynamicListReader):
  def __setitem__(self, index: int, value: Any) -> None: ...

def load(file_name: str, display_name: str | None = None, imports: Sequence[str] = ...) -> Any: ...
def add_import_hook() -> None: ...
def remove_import_hook() -> None: ...
